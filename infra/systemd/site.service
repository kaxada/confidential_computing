[Unit]
Description=Confidential Site RAG Service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/confidential/site-node
EnvironmentFile=-/opt/confidential/site-node/.env
ExecStart=/bin/bash -lc 'source /opt/confidential/venv-site/bin/activate && uvicorn server:app --host 0.0.0.0 --port 8080'
Restart=always

[Install]
WantedBy=multi-user.target
